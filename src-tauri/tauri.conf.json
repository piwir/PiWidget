{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PiWidget",
  "version": "0.2.0",
  "identifier": "com.piwidget.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "便笺",
        "width": 760,
        "height": 540,
        "minWidth": 560,
        "minHeight": 360,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "msi", "nsis"],
    "icon": ["icons/icon.png"]
  }
}
